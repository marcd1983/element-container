{
    "name": "antlion/element-container",
    "description": "elemental container block",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "element", "elemental", "content blocks"],
    "license": "BSD-3-Clause",
    "authors": [{
        "name": "Antlion"
    }],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "silverstripe/cms": "^6.0",
        "dnadesign/silverstripe-elemental": "^6.0",
        "silverstripe/vendor-plugin": "^3.0",
        "tractorcow/silverstripe-colorpicker": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Antlion\\ElementContainer\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "css"
        ]
    }
}
